{
  "name": "portfolio-backend-node",
  "version": "2.0.0",
  "description": "Netlify Functions backend for serving portfolio content as one JSON payload.",
  "type": "module",
  "main": "netlify/functions/portfolio-data.js",
  "scripts": {
    "dev": "npx --yes netlify-cli dev",
    "dev:local": "node scripts/local-server.js",
    "hash:password": "node scripts/hash-password.js",
    "migrate:redis": "node scripts/migrate-redis.js",
    "seed:redis": "node scripts/seed-redis.js",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "keywords": [
    "portfolio",
    "netlify-functions",
    "serverless"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.3",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6"
  }
